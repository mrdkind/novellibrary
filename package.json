{
  "name": "novel-library",
  "private": true,
  "version": "1.5.1",
  "description": "روایت بی‌پایان (Novel Library) — کتاب‌خوان آنلاین ناول و EPUB؛ کتابخانه‌ای رایگان و استاتیک با رابط فارسی",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.11"
  },
  "scripts": {
    "dev": "npm run build:catalog && vite",
    "build": "npm run build:catalog && tsc --noEmit && vite build",
    "preview": "npm run build && vite preview",
    "build:catalog": "node scripts/build-catalog.mjs",
    "validate:library": "node scripts/validate-library.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:samples": "node scripts/samples/make-sample-books.mjs",
    "make:fixtures": "node scripts/samples/make-test-fixtures.mjs"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^4.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  }
}
